[Unit]
Description=GTasks Dashboard Service
After=network.target

[Service]
Type=simple
User=sirus
WorkingDirectory=/home/sirus/latinem/projects/gtasks-terminal/gtasks_dashboard
ExecStart=/home/sirus/latinem/projects/gtasks-terminal/venv/bin/python3 main_dashboard.py
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1
Environment=PORT=8081
Environment=HOST=0.0.0.0

[Install]
WantedBy=multi-user.target
